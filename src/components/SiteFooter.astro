---
const year = new Date().getFullYear();
---

<footer id="studio" class="mt-32 border-t border-line py-24">

  <div class="mx-auto grid max-w-screen-xl grid-cols-1 gap-12 px-6 md:grid-cols-3">


    <!-- Brand -->

    <div class="space-y-4">

      <div class="font-serif text-lg italic tracking-tight">
        Lumavia Stone
      </div>

      <p class="max-w-[32ch] text-sm leading-relaxed text-faded">
        Natural stone products, garden sculptures, and custom stone carving
        crafted in Quyang, China.
      </p>

    </div>



    <!-- Inquiries -->

    <div class="space-y-4">

      <h2 class="text-xs font-medium uppercase tracking-widest">
        Inquiries
      </h2>


      <ul class="space-y-2 text-sm">

        <li>
          <a
            href="/contact"
            class="text-faded transition-colors hover:text-ink"
          >
            Product Inquiry
          </a>
        </li>


        <li>
          <a
            href="/contact"
            class="text-faded transition-colors hover:text-ink"
          >
            Custom Stone Carving
          </a>
        </li>


        <li>
          <a
            href="/about"
            class="text-faded transition-colors hover:text-ink"
          >
            About Lumavia
          </a>
        </li>

      </ul>

    </div>




    <!-- Follow -->

    <div class="space-y-4">

      <h2 class="text-xs font-medium uppercase tracking-widest">
        Follow
      </h2>


      <ul class="space-y-2 text-sm">

        <li>
          <a
            href="#"
            class="text-faded transition-colors hover:text-ink"
          >
            Instagram
          </a>
        </li>


        <li>
          <a
            href="/catalog"
            class="text-faded transition-colors hover:text-ink"
          >
            Collections
          </a>
        </li>


        <li>
          <a
            href="/blog"
            class="text-faded transition-colors hover:text-ink"
          >
            Journal
          </a>
        </li>

      </ul>

    </div>


  </div>



  <!-- Copyright -->

  <div
    class="mx-auto mt-16 max-w-screen-xl px-6 text-[10px] uppercase tracking-[0.2em] text-faded"
  >

    © {year} Lumavia Stone — Natural Stone & Garden Sculptures.

  </div>


</footer>