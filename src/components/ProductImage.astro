---
import type { Product } from "@/data/products";

interface Props {
  image: Product["images"][number];
  sizes: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
}
const { image, sizes, class: className, loading = "lazy", fetchpriority = "auto" } = Astro.props;
---
<!-- These WebP files were produced upstream. Use their existing sizes without Astro transforms. -->
<img
  src={image.src.src}
  srcset={image.variants.map((variant) => `${variant.src} ${variant.width}w`).join(", ")}
  sizes={sizes}
  width={image.src.width}
  height={image.src.height}
  alt={image.alt}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={className}
/>
