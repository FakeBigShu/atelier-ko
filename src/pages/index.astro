---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/atelier-hero.jpg";
import { formatPrice, getProducts } from "@/data/products.ts";

const products = await getProducts("stone-planter");

const featuredSlugs = [
  "stone-planter",
  "bird-bath",
  "custom-stone-piece",
];

const featured = featuredSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter(
    (product): product is NonNullable<typeof product> => product != null,
  );

const solo = products.find(
  (product) => product.slug === "animal-statue",
);

if (!solo) {
  throw new Error("Missing required featured product: animal-statue");
}
---

<BaseLayout
  title="Lumavia Stone — Natural Stone & Garden Sculpture"
  description="Natural stone products, garden sculpture, and custom stone carving for gardens, landscapes, and architectural spaces."
  image={heroImg}
>
  <main id="main-content">

    <h1 class="sr-only">
      Lumavia Stone — Natural Stone & Garden Sculpture
    </h1>


    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden bg-base">

      <!-- Mobile Hero -->
      <div class="md:hidden">

        <div class="aspect-[4/3] w-full">
          <Image
            src={heroImg}
            alt="Natural stone sculpture in an outdoor setting"
            width={1600}
            height={1280}
            format="webp"
            loading="eager"
            decoding="sync"
            class="h-full w-full object-cover object-right"
          />
        </div>

        <div class="space-y-6 px-6 py-12">

          <p
            class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded"
          >
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            Quyang, China · Stone Craftsmanship
          </p>

          <p
            class="text-balance font-serif text-4xl leading-[0.95]"
          >
            Natural stone
            <br />
            <span class="italic text-accent">
              for thoughtful spaces.
            </span>
          </p>

          <p
            class="max-w-[48ch] text-pretty leading-relaxed text-faded"
          >
            A curated collection of natural stone pieces for gardens,
            landscapes, architectural spaces, and bespoke projects.
          </p>

          <div
            class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center"
          >

            <a
              href="/catalog"
              class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              Explore Collections

              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </a>

            <a
              href="/about"
              class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
            >
              About Lumavia →
            </a>

          </div>

        </div>

      </div>


      <!-- ========================================================= -->
      <!-- DESKTOP HERO -->
      <!-- ========================================================= -->

      <div
        class="relative hidden h-[88vh] max-h-[920px] min-h-[640px] w-full md:block"
      >

        <!-- Full-width background image -->

        <Image
          src={heroImg}
          alt="Natural stone sculpture in an outdoor setting"
          width={2000}
          height={1400}
          format="webp"
          loading="eager"
          decoding="sync"
          class="absolute inset-0 h-full w-full object-cover object-right"
        />


        <!-- Left gradient -->

        <div
          aria-hidden="true"
          class="absolute inset-0"
          style="background: linear-gradient(90deg, var(--color-base) 0%, var(--color-base) 25%, color-mix(in oklab, var(--color-base) 75%, transparent) 40%, color-mix(in oklab, var(--color-base) 25%, transparent) 58%, transparent 78%)"
        ></div>


        <!-- Bottom gradient -->

        <div
          aria-hidden="true"
          class="absolute inset-x-0 bottom-0 h-48"
          style="background: linear-gradient(180deg, transparent, var(--color-base))"
        ></div>


        <!-- Content container -->

        <div
          class="relative mx-auto flex h-full max-w-screen-xl items-center px-6"
        >

          <div class="max-w-[480px] space-y-8">

            <p
              class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded"
            >
              <span class="inline-block h-px w-8 bg-ink/40"></span>

              Quyang, China · Stone Craftsmanship
            </p>


            <p
              class="text-balance font-serif text-5xl leading-[0.95] lg:text-6xl"
            >
              Natural stone
              <br />

              <span class="italic text-accent">
                for thoughtful spaces.
              </span>
            </p>


            <p
              class="max-w-[48ch] text-pretty leading-relaxed text-faded md:text-lg"
            >
              A curated collection of natural stone pieces for gardens,
              landscapes, architectural spaces, and bespoke projects.
            </p>


            <div class="flex items-center gap-6 pt-2">

              <a
                href="/catalog"
                class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
              >
                Explore Collections

                <span
                  aria-hidden="true"
                  class="transition-transform group-hover:translate-x-1"
                >
                  →
                </span>
              </a>


              <a
                href="/about"
                class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
              >
                About Lumavia →
              </a>

            </div>

          </div>

        </div>


        <!-- Product label -->

        <div
          class="absolute bottom-10 right-10 hidden flex-col items-end gap-1 text-[10px] uppercase tracking-[0.3em] text-ink/70 md:flex"
        >

          <span>
            No. 01 — Stone Planter
          </span>

          <span class="text-faded">
            Natural Stone · Garden Collection
          </span>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FEATURED PRODUCTS -->
    <!-- ========================================================= -->

    <section
      class="mx-auto max-w-screen-xl px-6 pt-24 md:pt-32"
    >

      <div
        class="mb-12 flex items-end justify-between gap-6 border-t border-line pt-10"
      >

        <div>

          <p
            class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded"
          >
            Selected stone pieces
          </p>


          <h2
            class="max-w-[20ch] text-balance font-serif text-3xl md:text-5xl"
          >
            A considered collection,

            <span class="italic text-accent">
              crafted in stone.
            </span>
          </h2>

        </div>


        <a
          href="/catalog"
          class="hidden items-center gap-2 whitespace-nowrap text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink md:inline-flex"
        >
          View all

          <span aria-hidden="true">
            →
          </span>
        </a>

      </div>


      <div
        class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3"
      >

        {featured.map((product) => (
          <ProductCard product={product} />
        ))}

      </div>


      <div class="mt-10 flex justify-center md:hidden">

        <a
          href="/catalog"
          class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
        >
          View all collections →
        </a>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- SOLO PRODUCT -->
    <!-- ========================================================= -->

    <section class="mt-32 md:mt-48">

      <div class="mx-auto max-w-screen-2xl px-6">

        <div
          class="grid items-center gap-10 md:grid-cols-12 md:gap-16"
        >

          <div class="md:col-span-7 lg:col-span-8">

            <a
              href={`/products/${solo.slug}`}
              class="group block aspect-[5/4] overflow-hidden rounded-[min(1vw,16px)] bg-paper md:aspect-[16/11]"
            >

              <Image
                src={solo.images[0]}
                alt={`${solo.name} — ${solo.shortDescription}`}
                width={1600}
                height={1100}
                loading="lazy"
                format="webp"
                class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.02]"
              />

            </a>

          </div>


          <div class="space-y-6 md:col-span-5 lg:col-span-4">

            <p
              class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded"
            >

              <span class="inline-block h-px w-8 bg-ink/40"></span>

              Sculpture Collection

            </p>


            <h2
              class="text-balance font-serif text-4xl leading-[1.02] md:text-5xl"
            >
              Stone with character.

              <span class="italic text-accent">
                Made to endure.
              </span>
            </h2>


            <p
              class="text-pretty leading-relaxed text-faded"
            >
              {solo.description}
            </p>


            <dl
              class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-2 text-xs"
            >

              <dt
                class="pt-3 uppercase tracking-[0.2em] text-faded"
              >
                Dimensions
              </dt>

              <dd class="pt-3">
                {solo.dimensions}
              </dd>


              <dt
                class="uppercase tracking-[0.2em] text-faded"
              >
                Finish
              </dt>

              <dd>
                {solo.finish}
              </dd>


              <dt
                class="uppercase tracking-[0.2em] text-faded"
              >
                Lead time
              </dt>

              <dd>
                {solo.leadTime}
              </dd>


              <dt
                class="uppercase tracking-[0.2em] text-faded"
              >
                From
              </dt>

              <dd class="tabular-nums">
                {formatPrice(solo.price)}
              </dd>

            </dl>


            <a
              href={`/products/${solo.slug}`}
              class="inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              View the piece →
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FEATURES -->
    <!-- ========================================================= -->

    <section
      class="mx-auto mt-32 max-w-screen-xl px-6 md:mt-48"
    >

      <div class="border-t border-line pt-12">

        <p
          class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded"
        >
          Our stone
        </p>


        <h2
          class="mb-12 max-w-[22ch] text-balance font-serif text-3xl md:text-5xl"
        >
          Selected for

          <span class="italic text-accent">
            character and permanence.
          </span>
        </h2>


        <div
          class="grid gap-x-8 gap-y-10 md:grid-cols-3"
        >

          {
            [
              {
                name: "Natural Stone",
                tag: "Timeless · tactile",
                copy:
                  "Natural stone brings weight, texture, and individuality to every piece. Each surface carries its own character.",
              },
              {
                name: "Quyang Craftsmanship",
                tag: "Skilled · enduring",
                copy:
                  "Rooted in Quyang's long tradition of stone carving, our work combines traditional craftsmanship with contemporary forms.",
              },
              {
                name: "Made for Projects",
                tag: "Flexible · considered",
                copy:
                  "From individual garden pieces to larger landscape projects, we develop products around practical requirements and design intent.",
              },
            ].map((material) => (
              <div class="space-y-3 pt-2">

                <p
                  class="text-[10px] uppercase tracking-[0.3em] text-faded"
                >
                  {material.tag}
                </p>


                <h3 class="font-serif text-2xl">
                  {material.name}
                </h3>


                <p
                  class="text-sm leading-relaxed text-faded"
                >
                  {material.copy}
                </p>

              </div>
            ))
          }

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- NEWSLETTER -->
    <!-- ========================================================= -->

    <section
      class="mx-auto mt-32 max-w-screen-xl px-6 md:mt-48"
    >

      <div class="border-t border-line pt-12">

        <div
          class="mx-auto max-w-xl space-y-6 text-center"
        >

          <p
            class="text-[11px] uppercase tracking-[0.3em] text-faded"
          >
            Stay informed
          </p>


          <h2
            class="text-balance font-serif text-3xl md:text-5xl"
          >
            New collections,

            <span class="italic text-accent">
              one email at a time.
            </span>
          </h2>


          <p
            class="mx-auto max-w-[52ch] text-sm leading-relaxed text-faded"
          >
            Follow new stone pieces, project updates, and custom carving opportunities from Lumavia Stone.
          </p>


          <form
            class="space-y-3 pt-4 text-left"
            data-newsletter-form
          >

            <div
              class="flex flex-col gap-3 sm:flex-row"
            >

              <label
                class="sr-only"
                for="first-name"
              >
                First name
              </label>


              <input
                id="first-name"
                name="firstName"
                type="text"
                required
                maxlength="80"
                placeholder="First name"
                class="flex-1 rounded-full bg-paper px-5 py-4 text-sm text-ink placeholder:text-faded/60 focus:outline-none focus:ring-1 focus:ring-ink disabled:opacity-50"
              />


              <label
                class="sr-only"
                for="email"
              >
                Email address
              </label>


              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="your@email.com"
                class="flex-1 rounded-full bg-paper px-5 py-4 text-sm text-ink placeholder:text-faded/60 focus:outline-none focus:ring-1 focus:ring-ink disabled:opacity-50"
              />

            </div>


            <button
              type="submit"
              class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent disabled:opacity-50"
              data-newsletter-button
            >
              Notify me
            </button>


            <p
              class="hidden pt-2 text-center text-sm text-accent"
              data-newsletter-success
              aria-live="polite"
            >
              You're on the list. We'll be in touch.
            </p>

          </form>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- STRUCTURED DATA -->
    <!-- ========================================================= -->

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Lumavia Stone",
        url:
          Astro.site?.href ??
          "https://lumaviastone.com/",
        slogan:
          "Natural Stone & Garden Sculpture",
        address: {
          "@type": "PostalAddress",
          addressRegion: "Hebei",
          addressCountry: "CN",
        },
      })}
    ></script>


    <!-- ========================================================= -->
    <!-- NEWSLETTER SCRIPT -->
    <!-- ========================================================= -->

    <script>
      const form =
        document.querySelector("[data-newsletter-form]");

      if (form) {
        const button =
          form.querySelector("[data-newsletter-button]");

        const success =
          form.querySelector("[data-newsletter-success]");

        form.addEventListener("submit", (event) => {
          event.preventDefault();

          if (button && success) {
            button.setAttribute("disabled", "true");
            button.textContent = "Saving...";

            window.setTimeout(() => {
              form.reset();

              button.removeAttribute("disabled");
              button.textContent = "Notify me";

              success.classList.remove("hidden");
            }, 450);
          }
        });
      }
    </script>

  </main>
</BaseLayout>