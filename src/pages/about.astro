---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
---

<BaseLayout
  title="About — Lumavia Stone"
  description="Learn about Lumavia Stone, our natural stone craftsmanship, and our approach to garden sculpture, landscape products, and custom stone carving in Quyang, China."
  image={workshopImg}
>
  <main id="main-content">

    <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">

      <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
        <span class="inline-block h-px w-8 bg-ink/40"></span>
        About Lumavia Stone
      </p>

      <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
        Natural stone,
        <span class="italic text-accent">crafted with purpose.</span>
      </h1>

      <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-faded">
        Lumavia Stone is a natural stone supplier and stone craftsmanship
        company based in Quyang, China. We develop and supply stone products
        for gardens, landscapes, architectural spaces, and custom projects.
        Our work combines traditional stone craftsmanship with practical
        requirements for international projects.
      </p>

    </section>


    <section class="relative w-full">

      <Image
        src={workshopImg}
        alt="Stone craftsmanship workshop in Quyang, China"
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        class="h-[50vh] w-full object-cover md:h-[70vh]"
      />

    </section>


    <section class="mx-auto mt-24 grid max-w-screen-xl gap-10 px-6 md:mt-32 md:grid-cols-12 md:gap-16">

      <div class="md:col-span-5">

        <p class="mb-6 text-[11px] uppercase tracking-[0.3em] text-faded">
          Quyang · Hebei · China
        </p>

        <h2 class="text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
          Rooted in a long tradition of stone carving.
        </h2>

      </div>


      <div class="space-y-6 leading-relaxed text-faded md:col-span-6 md:col-start-7">

        <p>
          Quyang has a long history of stone carving and sculpture.
          Generations of craftsmen have developed techniques for shaping,
          carving, finishing, and working with natural stone.
        </p>

        <p>
          Lumavia Stone builds on this craftsmanship while focusing on the
          needs of today's international buyers. We work with selected
          workshops and stone craftsmen to develop products that combine
          natural materials, reliable production, and practical requirements
          for gardens, landscapes, and architectural projects.
        </p>

      </div>

    </section>


    <section class="mx-auto mt-24 max-w-screen-xl border-t border-line px-6 pt-12 md:mt-32">

      <p class="mb-12 text-[11px] uppercase tracking-[0.3em] text-faded">
        How we work
      </p>

      <div class="grid gap-x-8 gap-y-12 md:grid-cols-3">

        {
          [
            {
              n: "01",
              h: "Natural stone, first",
              p: "We work with natural stone selected for its character, durability, color, texture, and suitability for the intended application.",
            },
            {
              n: "02",
              h: "Craftsmanship matters",
              p: "Traditional stone carving skills remain at the center of our work. Cutting, shaping, carving, and finishing are carried out with attention to detail.",
            },
            {
              n: "03",
              h: "Made for real projects",
              p: "From individual garden pieces to larger landscape and architectural projects, we focus on practical dimensions, finishes, packaging, and production requirements.",
            },
          ].map((block) => (
            <div class="space-y-3">

              <p class="text-[10px] uppercase tracking-[0.3em] text-faded tabular-nums">
                {block.n}
              </p>

              <h3 class="font-serif text-2xl">
                {block.h}
              </h3>

              <p class="text-sm leading-relaxed text-faded">
                {block.p}
              </p>

            </div>
          ))
        }

      </div>

    </section>


    <section class="mt-24 md:mt-32">

      <div class="mx-auto grid max-w-screen-2xl items-center gap-10 px-6 md:grid-cols-12 md:gap-16">

        <div class="md:col-span-5">

          <div class="aspect-[3/4] overflow-hidden rounded-[min(1vw,12px)] bg-paper">

            <Image
              src={handsImg}
              alt="Craftsman's hands working on a natural stone piece"
              width={1080}
              height={1440}
              format="webp"
              loading="lazy"
              class="h-full w-full object-cover"
            />

          </div>

        </div>


        <div class="space-y-8 md:col-span-6 md:col-start-7">

          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">

            <span class="inline-block h-px w-8 bg-ink/40"></span>

            On stone

          </p>


          <blockquote class="text-balance font-serif text-3xl leading-[1.15] md:text-4xl">

            "Every piece begins with the stone itself —
            its shape, texture, color, and natural character
            <span class="italic text-accent">
              guide what the finished piece can become.
            </span>"

          </blockquote>


          <p class="text-xs uppercase tracking-[0.25em] text-faded">
            — Lumavia Stone
          </p>


          <div class="space-y-3 border-t border-line pt-6 text-sm leading-relaxed text-faded">

            <p>
              We work with natural stone selected for different applications,
              from garden planters and bird baths to sculptures, fountains,
              spheres, and custom stone pieces.
            </p>

          </div>

        </div>

      </div>

    </section>


    <section class="mx-auto mt-24 max-w-screen-xl border-y border-line px-6 py-12 md:mt-32">

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">

        {
          [
            { n: "01", l: "Stone Craftsmanship" },
            { n: "06", l: "Current Product Types" },
            { n: "100%", l: "Natural Stone Focus" },
            { n: "8–10", l: "Typical Lead Time" },
          ].map((stat) => (
            <div class="space-y-2">

              <p class="font-serif text-4xl tabular-nums md:text-5xl">
                {stat.n}
              </p>

              <p class="text-[10px] uppercase tracking-[0.3em] text-faded">
                {stat.l}
              </p>

            </div>
          ))
        }

      </div>

    </section>


    <section id="studio" class="mx-auto mb-32 mt-12 max-w-screen-xl px-6 md:mt-16">

      <div class="grid items-end gap-10 md:grid-cols-12">

        <div class="md:col-span-7">

          <h2 class="max-w-[20ch] text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
            Explore our collections,
            or begin with a custom stone project.
          </h2>

        </div>


        <div class="flex flex-col gap-4 sm:flex-row md:col-span-5 md:justify-end">

          <a
            href="/catalog"
            class="inline-flex items-center justify-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
          >
            Explore the Catalogue →
          </a>

          <a
            href="mailto:studio@lumaviastone.com"
            class="inline-flex items-center justify-center gap-3 rounded-full px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-ink ring-1 ring-line transition-colors hover:bg-paper"
          >
            Contact Lumavia
          </a>

        </div>

      </div>

    </section>

  </main>
</BaseLayout>