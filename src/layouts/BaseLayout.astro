---
import { pageUrl } from "@/utils/urls";
import { siteConfig } from "@/config/site";
import "../styles.css";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";

const {
  title = `${siteConfig.brandName} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  image,
  noindex = false,
  includeHeader = true,
  includeFooter = true,
} = Astro.props;

const canonicalUrl = pageUrl(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
);

const socialImage = image ?? siteConfig.defaultSocialImage;
const ogImage = socialImage
  ? new URL(
      typeof socialImage === "string" ? socialImage : socialImage.src,
      Astro.site ?? Astro.url.origin
    ).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content={siteConfig.brandName}
    />

    <meta
      name="theme-color"
      content="#f8f7f4"
    />

    <link
      rel="canonical"
      href={canonicalUrl.href}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    {noindex && (
      <meta
        name="robots"
        content="noindex,nofollow"
      />
    )}

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:site_name"
      content={siteConfig.brandName}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content={canonicalUrl.href}
    />

    {ogImage && (
      <meta
        property="og:image"
        content={ogImage}
      />
    )}

    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {ogImage && (
      <meta
        name="twitter:image"
        content={ogImage}
      />
    )}


  </head>


  <body class="bg-base text-ink">

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-base)]"
    >
      Skip to content
    </a>


    {includeHeader && (
      <SiteHeader
        currentPath={Astro.url.pathname}
      />
    )}


    <div>
      <slot />
    </div>


    {includeFooter && <SiteFooter />}

  </body>
</html>